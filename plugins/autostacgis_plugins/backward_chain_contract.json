{
  "settings_schema": {
    "type": "object",
    "properties": {
      "max_steps": {
        "type": "integer",
        "minimum": 0,
        "default": 64,
        "description": "Maximum operations in a synthesized workflow."
      },
      "max_states": {
        "type": "integer",
        "minimum": 1,
        "default": 100000,
        "description": "Maximum expanded synthesis subproblems."
      },
      "max_bindings": {
        "type": "integer",
        "minimum": 1,
        "default": 100000,
        "description": "Maximum candidate input bindings."
      },
      "timeout": {
        "type": "number",
        "exclusiveMinimum": 0,
        "default": 120,
        "description": "Search time limit in seconds."
      }
    },
    "additionalProperties": false
  },
  "settings": {
    "max_steps": 64,
    "max_states": 100000,
    "max_bindings": 100000,
    "timeout": 120
  },
  "goal_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/goal",
    "$defs": {
      "goal": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "plugin": {
                "type": "string",
                "minLength": 1
              },
              "settings": {
                "type": "object"
              }
            },
            "required": [
              "plugin"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "output": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "require": {
                    "type": "object"
                  },
                  "from": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "select": {
                    "type": "object"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "coverage": {
                    "type": "object",
                    "properties": {
                      "geometry": {
                        "oneOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 4,
                            "maxItems": 4
                          }
                        ]
                      },
                      "mode": {
                        "enum": [
                          "footprint",
                          "bbox",
                          "metadata",
                          "valid_data"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "geometry"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "output"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "for_each": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "select": {
                    "type": "object"
                  },
                  "require": {
                    "type": "object"
                  },
                  "coverage": {
                    "type": "object",
                    "properties": {
                      "geometry": {
                        "oneOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 4,
                            "maxItems": 4
                          }
                        ]
                      },
                      "mode": {
                        "enum": [
                          "footprint",
                          "bbox",
                          "metadata",
                          "valid_data"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "geometry"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "for_each"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "all_of": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/goal"
                }
              }
            },
            "required": [
              "all_of"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "any_of": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/goal"
                }
              }
            },
            "required": [
              "any_of"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "algorithm": {
    "name": "backward_chain",
    "strategy": "bounded backward dataflow with memoization and metadata predicate regression"
  }
}
